# ==============================================================================
# BeE Printer Platform - Environment Configuration
# ==============================================================================

# Cổng truy cập Web Dashboard (Mặc định: 8000)
# Nếu cổng 8000 đã có dịch vụ khác sử dụng, đổi thành 8080 hoặc 8888
BEE_PORT=8000

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# Thư mục lưu trữ database SQLite và file 3MF/G-code đã tải lên
DATA_PATH=./data

# Dải mạng Wi-Fi/LAN quét máy in (cho môi trường Docker)
DISCOVERY_EXTRA_SUBNETS=192.168.1.0/24

